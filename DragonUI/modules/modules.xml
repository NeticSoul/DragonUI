<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- Conflict Detection module (loaded early) -->
    <Script file="compatibility.lua"/>

    <!-- Actionbar modules -->
    <Script file="noop.lua"/>
    <Script file="buttons.lua"/>
    <Script file="rage_indicator.lua"/>
    <Script file="cooldowns.lua"/>
    <Script file="auracooldowns.lua"/>
    <Script file="mainbars.lua"/>
    
    <!-- Action Bar Sub-modules (stance, vehicle, petbar, multicast) -->
    <Include file="actionbars\actionbars.xml"/>
    
    <!-- Pets & Mounts window (its micro button must exist before micromenu.lua loads) -->
    <Script file="..\data\companion_traits.lua"/>
    <Script file="..\data\mount_speeds.lua"/>
    <Include file="collections\collections.xml"/>
    <!-- Professions micro button (must exist before micromenu.lua loads; the window itself loads further down) -->
    <Script file="professions\prof_microbutton.lua"/>

    <!-- Micro Menu & Bag module -->
    <Script file="micromenu.lua"/>
    
    <!-- KeyBinding module -->
    <Script file="keybinding.lua"/>

    <!-- Key Press module (fire actions on key down instead of key release) -->
    <Script file="keypress.lua"/>
    
    <!-- Buffs, Minimap & Quest Tracker modules -->
    <Script file="buff_frame.lua"/>
    <Script file="auraborders.lua"/>
    <Script file="minimap_collector.lua"/>
    <Script file="minimap.lua"/>
    <Script file="minimap_decorations.lua"/>
    <Script file="minimap_ping.lua"/>
    <Script file="objectivetracker.lua"/>   
    <Script file="lootroll.lua"/>

    <!-- Blizzard loot window skin (the paginated LootFrame, not the roll popup above) -->
    <Script file="loot_skin.lua"/>

 
    <!-- UnitFrames -->
    <Include file="unitframes\unitframes.xml"/>
    
    <!-- Cast Bar module -->
    <Script file="castbar.lua"/>
    <Script file="gcd.lua"/>
    
    <!-- Game Menu module -->
    <Script file="gamemenu_dragons.lua"/>
    <Script file="gamemenu.lua"/>
    
    <!-- Editor Mode module -->
    <Script file="editor_mode.lua"/>
    
    <!-- Dark Mode module -->
    <Script file="darkmode.lua"/>
    
    <!-- Tooltip Enhancement module -->
    <Script file="tooltip.lua"/>
    
    <!-- Nameplates (custom stack on 30300 Blizzard plates) -->
    <Script file="..\data\npc_rare_ranks.lua"/>
    <Script file="..\data\aura_durations.lua"/>
    <Include file="nameplates\nameplates.xml"/>
    
    <!-- Item Quality Borders module -->
    <Script file="itemquality.lua"/>

    <!-- Item Level on gear icons -->
    <Script file="itemlevel.lua"/>

    <!-- Per-character bag, bank and equipped counts in item tooltips -->
    <Script file="itemownership.lua"/>

    <!-- Automatic equipped-item comparison, including chat item links -->
    <Script file="equipmentcompare.lua"/>

    <!-- Retail-style character window reskin -->
    <Include file="characterpanel\characterpanel.xml"/>

    <!-- Retail-style vendor window reskin -->
    <Include file="merchant\merchant.xml"/>

    <!-- Retail-style quest and gossip dialog reskin -->
    <Script file="questdialog.lua"/>

    <!-- Retail-style flight master map window reskin -->
    <Script file="taxiframe.lua"/>

    <!-- Retail-style mail window reskin with Open All button -->
    <Script file="mail.lua"/>

    <!-- Spellbook module (own window; takes over the book's keys, micro button and Blizzard's frame after login) -->
    <Include file="spellbook\spellbook.xml"/>
    <!-- Professions module (Forever professions window built on Blizzard's TradeSkillFrame) -->
    <Include file="professions\professions.xml"/>

    <!-- Chat Mods module -->
    <Script file="chatmods.lua"/>
    
    <!-- Bag item usability tint (shared by bagster and bags_skin; must load before both) -->
    <Script file="bags_usability.lua"/>

    <!-- Retail new-item glow (shared by bagster and bags_skin; must load before both) -->
    <Script file="bags_newitems.lua"/>

    <!-- Bagster bag replacement module -->
    <Include file="bagster\bagster.xml"/>

    <!-- Blizzard bag window skin -->
    <Script file="bags_skin.lua"/>
    
    <!-- Bag Sort module (sort buttons for bags and bank) -->
    <Script file="bagsort.lua"/>

    <!-- Alt Gold module (other characters' money on the bag coin tooltip) -->
    <Script file="altmoney.lua"/>

    <!-- Retail-style world map -->
    <Include file="worldmap\worldmap.xml"/>

    <!-- Talents module -->
    <Include file="talents\talents.xml"/>

    <!-- Version Check module (cross-player version broadcast) -->
    <Script file="versioncheck.lua"/>

    <!-- Level Up Enhance (level-up banner with the unlocks list; reads spellbook\trainerdata.lua) -->
    <Include file="levelupenhance\levelupenhance.xml"/>

    <!-- Low HP Alert (screen-edge flash and sound on low health) -->
    <Script file="hp_low_alert.lua"/>

    <!-- Personal Resource Display (small health and power bar under the character) -->
    <Script file="personalresource.lua"/>

    <!-- Swing timers (main hand, off hand and ranged bars fed by LibSwingTimer-1.0) -->
    <Script file="swingtimer.lua"/>

    <!-- Auto-accept party invites from friends and guild members -->
    <Script file="autoaccept.lua"/>

    <!-- Max camera distance past the Interface slider -->
    <Script file="camera.lua"/>

    <!-- Addon Manager module -->
    <Script file="addonmanager_icons.lua"/>
    <Script file="addonmanager.lua"/>
</Ui>
